<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework Condition=" '$(Configuration)'=='Debug' ">net11.0</TargetFramework>
		<TargetFramework Condition=" '$(Configuration)'=='Release' ">net11.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<PublishAot>true</PublishAot>
		<IsAotCompatible>true</IsAotCompatible>
		<InvariantGlobalization>true</InvariantGlobalization>
		<IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<LangVersion>preview</LangVersion>
		<Features Condition="'$(TargetFramework)' == 'net11.0'">runtime-async=on</Features>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DotNext.IO" Version="6.8.0" />
		<PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
		<PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
		<PackageReference Include="Roslynator.Analyzers" Version="5.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.Linq.Async" Version="7.0.1" />
		<PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 大包隧道的 protobuf 载荷默认 ≥85KB 就进 LOH：实测 16 条 256KB 回声隧道会触发约 31 次/秒 gen2 GC。
		     抬到 8MB 后这些数组留在小对象堆：JIT 吞吐 +13%，AOT 对照发布 +38%（3.19→4.40 GB/s）、CPU 更低。
		     NativeAOT 会读取该配置（已验证），部署时无需额外环境变量。 -->
		<RuntimeHostConfigurationOption Include="System.GC.LOHThreshold" Value="8388608" />
	</ItemGroup>

	<ItemGroup>
		<!-- 与 CoreProxy.Exe 共用仓库根目录下的同一份协议定义，避免两端漂移 -->
		<Protobuf Include="..\proto\TextFile.proto" GrpcServices="Server" />
	</ItemGroup>

	<ItemGroup>
		<!-- 让测试项目可直接单测 TargetResolver.PickPreferred 等 internal 成员 -->
		<InternalsVisibleTo Include="CoreProxy.Server.Orleans.Tests" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="Microsoft.AspNetCore.Server.Kestrel.Transport.Sockets" />
	</ItemGroup>
</Project>
